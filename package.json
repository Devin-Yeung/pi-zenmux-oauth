{
  "name": "pi-zenmux-oauth",
  "version": "0.3.0",
  "description": "ZenMux OAuth provider for Pi, implemented in TypeScript",
  "keywords": [
    "ai",
    "llm",
    "oauth",
    "pi",
    "pi-package",
    "pkce",
    "zenmux"
  ],
  "bugs": {
    "url": "https://github.com/Devin-Yeung/pi-zenmux-oauth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devin-Yeung/pi-zenmux-oauth.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm test && npm run check",
    "dev": "pi --approve --no-session -e ./src/index.ts"
  },
  "dependencies": {
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.1",
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
